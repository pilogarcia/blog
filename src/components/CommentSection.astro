---
interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}

const { pageId, pageTitle, pageUrl } = Astro.props;

// Reemplazá por tu App ID real de Cusdis (Settings del sitio en cusdis.com).
const CUSDIS_APP_ID = '0671f1eb-3897-435c-bcd0-e826d2e1dcee';
---
<section class="comments">
  <h3 class="font-mono comments-heading">Comentarios</h3>
  <div
    id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id={CUSDIS_APP_ID}
    data-page-id={pageId}
    data-page-title={pageTitle}
    data-page-url={pageUrl}
  ></div>
</section>

<script is:inline src="https://cusdis.com/js/cusdis.es.js" async></script>

<style>
  .comments { max-width: 900px; margin: 0 auto; padding: 0 1.5rem 6rem; }
  .comments-heading {
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 2rem; padding-top: 3rem;
    border-top: 1px solid var(--border);
  }
</style>
