---
interface Props {
  postId: string;
}
const { postId } = Astro.props;
---
<!-- Le pasamos el postId al div contenedor para que el script lo lea de ahí -->
<div class="comments-section" data-post-id={postId}>
  <h2 class="comments-title">Comentarios</h2>
  
  <form id="comment-form" class="comment-form">
    <input type="text" id="comment-author" placeholder="Tu nombre" required class="comment-input" />
    <textarea id="comment-content" placeholder="Escribe tu comentario..." required class="comment-textarea"></textarea>
    <button type="submit" class="comment-btn">Enviar comentario</button>
  </form>

  <div id="comments-list" class="comments-list">
    <p class="loading-text">Cargando comentarios...</p>
  </div>
</div>

<style>
  .comments-section {
    max-width: 900px;
    margin: 4rem auto 5rem;
    padding: 0 1.5rem;
  }
  .comments-title {
    font-family: 'Noto Serif Display', serif;
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 2rem;
    color: var(--fg);
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .comment-input {
    padding: 0.8rem;
    background: transparent;
    border: 1px solid var(--border-light);
    font-family: 'Libertinus Serif', serif;
    font-size: 1rem;
    color: var(--fg);
  }
  .comment-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .comment-textarea {
    padding: 0.8rem;
    background: transparent;
    border: 1px solid var(--border-light);
    font-family: 'Libertinus Serif', serif;
    font-size: 1rem;
    color: var(--fg);
    min-height: 120px;
    resize: vertical;
  }
  .comment-textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .comment-btn {
    align-self: flex-start;
    padding: 0.8rem 1.5rem;
    background: transparent;
    color: #333;
    border: 1px solid var(--border-light);
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    border-bottom-right-radius: 10px;
    transition: background 0.3s;
  }
  .comment-btn:hover {
    background: var(--accent-bright);
  }
  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .comment-item {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 1.5rem;
  }
  .comment-author {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 0.5rem;
  }
  .comment-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--muted);
    margin-left: 1rem;
  }
  .comment-content {
    font-family: 'Libertinus Serif', serif;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--fg-dim);
  }
  .loading-text {
    font-family: 'Libertinus Serif', serif;
    font-style: italic;
    color: var(--muted);
  }
</style>

<script>
  // Leemos el postId desde el atributo data-post-id del div contenedor
  const section = document.querySelector('.comments-section') as HTMLElement;
  if (section) {
    const postId = section.dataset.postId;
    
    const form = document.getElementById('comment-form') as HTMLFormElement;
    const authorInput = document.getElementById('comment-author') as HTMLInputElement;
    const contentInput = document.getElementById('comment-content') as HTMLTextAreaElement;
    const list = document.getElementById('comments-list') as HTMLDivElement;

    // Cargar comentarios
    async function loadComments() {
      try {
        const res = await fetch('/api/comments?postId=' + postId);
        const comments = await res.json();
        
        list.innerHTML = '';

        if (comments.length === 0) {
          const p = document.createElement('p');
          p.className = 'loading-text';
          p.textContent = 'Sé el primero en comentar.';
          list.appendChild(p);
          return;
        }

        comments.forEach((c: any) => {
          const item = document.createElement('div');
          item.className = 'comment-item';

          const header = document.createElement('div');
          const author = document.createElement('span');
          author.className = 'comment-author';
          author.textContent = c.author;
          const date = document.createElement('span');
          date.className = 'comment-date';
          date.textContent = new Date(c.created_at).toLocaleDateString('es-AR');
          
          header.appendChild(author);
          header.appendChild(date);

          const content = document.createElement('p');
          content.className = 'comment-content';
          content.textContent = c.content;

          item.appendChild(header);
          item.appendChild(content);
          list.appendChild(item);
        });
      } catch (e) {
        list.innerHTML = '';
        const p = document.createElement('p');
        p.className = 'loading-text';
        p.textContent = 'Error al cargar comentarios.';
        list.appendChild(p);
      }
    }

    // Enviar comentario
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const author = authorInput.value;
      const content = contentInput.value;

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ post_id: postId, author, content })
        });

        if (res.ok) {
          authorInput.value = '';
          contentInput.value = '';
          loadComments();
        }
      } catch (e) {
        alert('Hubo un error al enviar el comentario.');
      }
    });

    loadComments();
  }
</script>