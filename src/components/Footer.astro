---
// Footer limpio sin líneas ni copyright
---
<footer class="site-footer">
  <div class="footer-inner">
    
    <!-- Redes a la izquierda -->
    <nav class="footer-socials">
      <a href="https://youtube.com/@elojoinusual" target="_blank" rel="noopener">YouTube</a>
      <a href="https://instagram.com/elojoinusual" target="_blank" rel="noopener">Instagram</a>
      <a href="https://open.spotify.com/show/0341dMFCs1p7XmDnjkM4bB" target="_blank" rel="noopener">Spotify</a>
    </nav>

    <!-- Mail al lado de las redes -->
    <div class="footer-mail-sec">
      <a href="mailto:contacto@elojoinusual.com.ar" class="footer-mail">
        contacto@elojoinusual.com.ar
      </a>
    </div>

  </div>
</footer>

<style>
  .site-footer { 
    padding: 2.5rem 1.5rem; /* Le sacamos el border-top */
  }
  .footer-inner {
    max-width: 1400px; margin: 0 auto; 
    display: flex; flex-wrap: wrap;
    justify-content: flex-start; /* Alineamos todo a la izquierda */
    align-items: center; 
    gap: 2.5rem; /* Espacio entre las redes y el mail */
  }
  
  /* Tipografía general */
  .footer-socials a, .footer-mail {
    font-family: 'Libertinus Serif', serif;
    font-size: 1.1rem;
    color: var(--fg-dim);
    transition: color 0.3s;
  }
  .footer-socials a:hover, .footer-mail:hover {
    color: var(--accent);
  }

  /* Redes */
  .footer-socials {
    display: flex;
    align-items: center;
  }
  .footer-socials a {
    margin-right: 2.5rem; /* Espacio entre cada red */
  }
  .footer-socials a:last-child {
    margin-right: 0;
  }

  /* Mail */
  .footer-mail-sec {
    text-align: left;
  }

  /* En móviles que se apilen hacia la izquierda */
  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }
</style>