---
interface Props {
  texto: string;
  autor?: string;
}

const { texto, autor } = Astro.props;
---

<figure class="my-8 border-l-2 border-neutral-400 pl-6 py-2 italic">
  <div class="whitespace-pre-line font-serif text-lg leading-relaxed">
    {texto}
  </div>
  {autor && (
    <figcaption class="mt-3 text-sm not-italic opacity-75">
      — {autor}
    </figcaption>
  )}
</figure>
