---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prev?: CollectionEntry<'blog'> | null;
  next?: CollectionEntry<'blog'> | null;
}

const { prev, next } = Astro.props;
---
{(prev || next) && (
  <nav class="prev-next" aria-label="Navegación entre artículos">
    {prev ? (
      <a href={`/blog/${prev.id}/`} class="pn-link pn-prev notch-corner">
        <span class="font-mono pn-label">← Anterior</span>
        <!-- Le saqué la clase font-display de acá -->
        <span class="pn-title">{prev.data.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a href={`/blog/${next.id}/`} class="pn-link pn-next notch-corner">
        <span class="font-mono pn-label">Siguiente →</span>
        <!-- Y de acá -->
        <span class="pn-title">{next.data.title}</span>
      </a>
    ) : <span></span>}
  </nav>
)}

<style>
  .prev-next {
    max-width: 900px; margin: 0 auto 5rem; padding: 0 1.5rem;
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
  }
  .pn-link {
    display: flex; flex-direction: column; gap: 0.6rem;
    padding: 1.5rem 0; transition: opacity 0.3s;
  }
  .pn-link:hover { opacity: 0.7; }
  .pn-link:hover { border-color: var(--accent-dim); background: var(--bg-card-hover); }
  .pn-next { text-align: right; align-items: flex-end; }
  .pn-label { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); }
  
  /* Acá le aplicamos la tipografía Noto Serif Display */
  .pn-title { 
    font-family: 'Noto Serif Display', serif; 
    font-size: 1.3rem; 
    line-height: 1.2; 
    color: var(--fg); 
    font-weight: 400; 
    text-transform: none; /* Respetar mayúscula tipo oración */
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .prev-next { grid-template-columns: 1fr; }
    .pn-next { text-align: left; align-items: flex-start; }
  }
</style>