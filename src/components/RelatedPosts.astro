---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  tag: string;
}

const { posts, tag } = Astro.props;
---
{posts.length > 0 && (
  <section class="related">
    <div class="related-inner">
      <p class="font-mono related-heading">También en {tag}</p>
      <div class="related-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
)}

<style>
  .related { padding: 0 1.5rem; margin-bottom: 5rem; }
  .related-inner { max-width: 1200px; margin: 0 auto; }
  .related-heading {
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 1.5rem; padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .related-grid { display: grid; grid-template-columns: 1fr; gap: 1.75rem; }
  @media (min-width: 700px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
