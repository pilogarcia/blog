---
// Componente Search.astro
---
<div id="search-modal" class="search-modal hidden">
  <div class="search-modal-content">
    <span class="font-mono search-title">BUSCAR EN EL BLOG</span>
    <div id="search"></div>
  </div>
</div>

<style>
  .search-modal {
    position: fixed !important; 
    top: 0; left: 0; 
    width: 100% !important; 
    height: 100% !important;
    background: rgba(0,0,0,0.85) !important; 
    z-index: 2147483647 !important; 
    display: flex !important; 
    align-items: flex-start !important; 
    justify-content: center !important;
    padding-top: 15vh !important;
    overflow-y: auto !important;
  }
  /* ACÁ ESTÁ EL ARREGLO PARA QUE NO APAREZCA ABIERTO DE ENTRADA */
  .search-modal.hidden {
    display: none !important; 
  }
  
  .search-modal-content {
    background: #ffffff;
    border: 1px solid #ddd;
    width: 90%; max-width: 650px; padding: 2rem;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    position: relative;
    z-index: 10;
    border-top: 4px solid #2cc8e7;
  }

  .search-title {
    display: block;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: #131313;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('search-toggle');
    const modal = document.getElementById('search-modal');

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    function loadPagefind() {
      if (window.pagefindLoaded) return;
      window.pagefindLoaded = true;
      
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => {
        if (window.PagefindUI) {
          new window.PagefindUI({ element: "#search", showSubResults: true });
          const clearBtn = document.querySelector('.pagefind-ui__search-clear');
          if (clearBtn) {
            const closeBtn = document.createElement('button');
            closeBtn.innerText = 'Cerrar ✕';
            closeBtn.className = 'search-close-btn';
            closeBtn.addEventListener('click', closeModal);
            clearBtn.parentNode.insertBefore(closeBtn, clearBtn.nextSibling);
          }
          const input = document.querySelector('.pagefind-ui__search-input');
          if (input) input.focus();
        }
      };
      document.body.appendChild(script);
    }

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden'); // Saca el hidden para que aparezca
      document.body.style.overflow = 'hidden';
      loadPagefind();
      setTimeout(() => {
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
      }, 100);
    }

    if (toggle) toggle.addEventListener('click', openModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>