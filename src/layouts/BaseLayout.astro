---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollTopButton from '../components/ScrollTopButton.astro';
import { SITE_TITLE } from '../consts';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
}

const {
  title,
  description = 'El Ojo Inusual — Un blog de Interés general, cultura filosofía, música, poesía, ciencia, creencias y experiencias de vida.',
  image = '/images/og-default.jpg',
  type = 'website',
  pubDate,
  author
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   <title>{title} | El Ojo Inusual</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Auto-descubrimiento de Sitemap y RSS -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="El Ojo Inusual" href={new URL('rss.xml', Astro.site)} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — El Ojo Inusual`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <!-- Dimensiones estándar para WhatsApp/Facebook (1200x630) -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="El Ojo Inusual" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — El Ojo Inusual`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <!-- Datos Estructurados para Google (JSON-LD) -->
    {type === 'article' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": description,
        "image": ogImageURL.toString(),
        "author": {
          "@type": "Person",
          "name": author || "El Ojo Inusual"
        },
        "datePublished": pubDate ? pubDate.toISOString() : undefined,
        "publisher": {
          "@type": "Organization",
          "name": "El Ojo Inusual",
          "logo": {
            "@type": "ImageObject",
            "url": new URL('/favicon.svg', Astro.site).toString()
          }
        }
      })} />
    )}

    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "5f498ae863144aa6bb353835ef12acd5"}'></script>
  </head>
  <body>
    <div class="grain"></div>
    
    <div style="isolation: isolate; position: relative; z-index: 50;">
      <Header />
    </div>
    
    <main style="isolation: isolate; position: relative; z-index: 0;">
      <slot />
    </main>
    
    <Footer />
    <ScrollTopButton />
    
    <Search /> 
  </body>
</html>