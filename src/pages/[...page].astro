---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import TagFilter from '../components/TagFilter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { POSTS_PER_PAGE } from '../consts';
import type { GetStaticPathsOptions, Page } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tags = [...new Set(allPosts.map((p) => p.data.tag))];

const urlFor = (n: number) => (n === 1 ? '/' : `/${n}/`);

const isFeaturedPage = page.currentPage === 1;

// Agrupar posts por Año y Mes
const monthsNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
const archiveData = allPosts.reduce((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());
  const month = post.data.pubDate.getMonth();
  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = 0;
  acc[year][month]++;
  return acc;
}, {} as Record<string, Record<number, number>>);
const sortedYears = Object.keys(archiveData).sort((a, b) => Number(b) - Number(a));

const popularPosts = allPosts.filter(post => (post.data as any).popular).slice(0, 3);
const topPosts = popularPosts.length >= 3 ? popularPosts : [...popularPosts, ...allPosts.filter(p => !(p.data as any).popular)].slice(0, 3);
---
<BaseLayout title="Blog">
  <!-- HERO MINIMALISTA -->
  <section class="hero-strip">
    <div class="hero-inner">
      <h1 class="hero-title">
        El Ojo Inusual,
        un <i>blog</i><br>por una <i>poética</i> acaso inútil<br>pero no. <br>
        Textos para volver 
        al estado<br>de <i>reflexión</i>.
      </h1>
    </div>
  </section>

  <section class="articles" id="articulos">
    <div class="articles-inner">
      <TagFilter tags={tags} />

      {page.data.length === 0 && (
        <p class="font-body empty">Todavía no hay artículos publicados.</p>
      )}

      <div class="blog-layout">
        
        <!-- Columna principal: Artículos -->
        <main class="main-content">
          <div class="grid">
            {page.data.map((post, i) => (
              <PostCard 
                post={post} 
                index={i} 
                featured={isFeaturedPage && i === 0} 
              />
            ))}
          </div>
          <Pagination currentPage={page.currentPage} lastPage={page.lastPage} urlFor={urlFor} />
        </main>

        <!-- Columna lateral: Sidebar -->
        <aside class="sidebar font-mono">
          
          <!-- Caja de Donación -->
          <div class="sidebar-box donate-box">
            <h3 class="sidebar-title">Apoyar el blog</h3>
            
           <a href='https://cafecito.app/elojoinusual' rel='noopener' target='_blank'><img srcset='https://cdn.cafecito.app/imgs/buttons/button_5.png 1x, https://cdn.cafecito.app/imgs/buttons/button_5_2x.png 2x, https://cdn.cafecito.app/imgs/buttons/button_5_3.75x.png 3.75x' src='https://cdn.cafecito.app/imgs/buttons/button_5.png' alt='Invitame un café en cafecito.app' /></a>
          </div>

          <!-- Más Leídos -->
                   <!-- Más Leídos -->
          <!-- Más Leídos -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">Lo más leído</h3>
            <ul class="popular-list">
              {topPosts.map((post) => (
                <li class="popular-item">
                  <a href={`/blog/${post.id}/`} class="popular-title font-body">{post.data.title}</a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Archivo -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">Archivo</h3>
            <ul class="archive-list">
              {sortedYears.map(year => (
                <li class="archive-year">
                  <span class="year-title">{year}</span>
                  <ul class="archive-months">
                    {Object.keys(archiveData[year]).sort((a, b) => Number(b) - Number(a)).map(monthIdx => {
                      const monthNum = Number(monthIdx);
                      return (
                        <li>
                          <a href={`/archivo/${year}/${monthNum + 1}/`}>
                            {monthsNames[monthNum]} ({archiveData[year][monthNum]})
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              ))}
            </ul>
          </div>

          <!-- Sobre el Autor -->
         <!-- Sobre el Autor -->
          <div class="sidebar-box author-box">
            <div class="author-top">
              <img src="/images/autor.jpg" alt="Pilo García" class="author-img" />
              <div class="author-info">
                <span class="author-name">Pilo García</span>
                <!-- Acá movimos el link para que quede justo debajo del nombre -->
                <a href="/sobre-mi/" class="author-link">Ver quién soy →</a>
              </div>
            </div>
          </div>
          
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- ESTILOS DEL HERO --- */
  .hero-strip { 
    position: relative; 
    padding: 8rem 1.5rem 6rem; 
    border-bottom: none; 
    background: #ffffff; 
    display: flex; 
    align-items: center; 
  }
  .hero-inner { 
    position: relative; z-index: 1; max-width: 1400px; width: 100%;
    margin: 0 auto; text-align: left; padding: 0 1.5rem; box-sizing: border-box;
  }
  .hero-title { 
    font-family: 'Noto Serif Display', serif; 
    font-size: clamp(2rem, 6vw, 4.5rem); 
    line-height: 1.05; margin: 0; color: #000000; 
    font-weight: 200; letter-spacing: -0.01em; 
    transform: scaleX(0.9); transform-origin: left center; 
  }
  .hero-title i { font-weight: 200; transform: scaleX(0.9); transform-origin: left center; font-style: italic; }

  /* Estilos de los Artículos */
  .articles { padding: 5rem 1.5rem 7rem; }
  .articles-inner { max-width: 1400px; margin: 0 auto; }
  .empty { color: var(--muted); }

  /* Layout de dos columnas */
  .blog-layout { display: flex; flex-direction: column; gap: 3rem; }
  @media (min-width: 900px) {
    .blog-layout { flex-direction: row; align-items: flex-start; }
    .main-content { flex: 1; min-width: 0; }
    .sidebar { flex: 0 0 280px; position: sticky; top: 2rem; }
  }

  /* NUEVA GRILLA ESTRICTA DE 3 COLUMNAS */
  .grid { 
    display: grid; 
    grid-template-columns: 1fr; /* 1 columna en móvil */
    gap: 2rem; 
  }
  @media (min-width: 700px) { 
    .grid { grid-template-columns: repeat(2, 1fr); /* 2 columnas en tablet */
    } 
  }
  @media (min-width: 1000px) { 
    .grid { grid-template-columns: repeat(3, 1fr); /* 3 columnas en escritorio */
    } 
  }

  /* Estilos para el Sidebar */
  .sidebar-box { padding: 0 0 2rem 0; margin-bottom: 2rem; border-bottom: 1px solid var(--border-light); }
  .sidebar-box:last-child { border-bottom: none; }
 .sidebar-title { 
    font-family: 'Libertinus Serif', serif; 
    font-size: 1.2rem; 
    font-weight: 163;
    letter-spacing: normal; /* Le sacamos el espaciado exagerado */
    margin-bottom: 1rem; 
    color: #333333; 
  }
  .sidebar-text { font-size: 13px; color: var(--fg-dim); margin-bottom: 1.2rem; line-height: 1.5; }
  .cafecito-btn { display: block; text-align: left; }
  .cafecito-img { max-width: 100%; height: auto; display: inline-block; transition: transform 0.2s; }
  .cafecito-img:hover { transform: translateY(-2px); }
  
      .popular-list { list-style: none; padding: 0; margin: 0; }
  .popular-item { 
    margin-bottom: 1.2rem; /* Espacio entre un título y otro */
  }
  .popular-item:last-child { margin-bottom: 0; }
  
  .popular-title { 
    font-family: 'Libertinus Serif', serif; /* Usamos la tipografía de los artículos */
    font-size: 1rem; 
    color: var(--fg-dim); 
    text-decoration: none; 
    line-height: 1.4; 
    transition: color 0.3s; 
  }
  .popular-title:hover { color: var(--accent); }

  .archive-list { list-style: none; padding: 0; margin: 0; }
  .archive-year { margin-bottom: 1.2rem; }
  .year-title { 
    display: block; 
    font-family: 'Libertinus Serif', serif; 
    font-size: 1rem; 
    font-weight: 163; 
    color: #333333; 
    margin-bottom: 0.5rem; 
  }
  .archive-months { list-style: none; padding-left: 0.8rem; margin: 0; }
  .archive-months li { margin-bottom: 0.3rem; }
  .archive-months a { color: var(--fg-dim); font-size: 13px; text-decoration: none; transition: color 0.3s; }
  .archive-months a:hover { color: var(--accent); }

  .author-box { display: flex; flex-direction: column; align-items: flex-start; text-align: left; padding-top: 1rem; gap: 1rem; }
  .author-top { display: flex; align-items: center; gap: 1rem; }
  .author-img { width: 60px; height: 60px; object-fit: cover; border-radius: 0; filter: grayscale(40%); border: 1px solid var(--border-light); border-bottom-right-radius: 10px; }
   .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
   .author-name {
    font-family: 'Libertinus Serif', serif;
    font-size: 1.1rem;
    font-weight: 163;
    color: var(--fg);
    line-height: 1.2;
  }
  .author-role { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); }
  .author-link { font-size: 11px; color: var(--fg-dim); text-decoration: none; letter-spacing: 0.1em; text-transform: uppercase; transition: color 0.3s; }
  .author-link:hover { color: var(--accent); }
</style>