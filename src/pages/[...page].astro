---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import TagFilter from '../components/TagFilter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { POSTS_PER_PAGE } from '../consts';
import type { GetStaticPathsOptions, Page } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const tags = [...new Set(allPosts.map((p) => p.data.tag))];

const urlFor = (n: number) => (n === 1 ? '/' : `/${n}/`);

const isFeaturedPage = page.currentPage === 1;

// Agrupar posts por Año y Mes
const monthsNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

const archiveData = allPosts.reduce((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());
  const month = post.data.pubDate.getMonth();
  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = 0;
  acc[year][month]++;
  return acc;
}, {} as Record<string, Record<number, number>>);

const sortedYears = Object.keys(archiveData).sort((a, b) => Number(b) - Number(a));
---
<BaseLayout title="Blog">
  <!-- El Hero con tus cambios personalizados de GitHub -->
  <section class="hero-strip">
    <div class="hero-bg">
      <div class="hero-bg-img hero-bg-img-1"></div>
      <div class="hero-bg-img hero-bg-img-2"></div>
      <div class="hero-bg-img hero-bg-img-3"></div>
      <div class="hero-bg-overlay"></div>
    </div>
    <div class="hero-inner">
      <p class="font-mono eyebrow">EL OJO INUSUAL</p>
      <h1 class="font-display hero-title">
        UN BLOG<span class="text-stroke"> INUSUAL</span><br>
        POR UNA POÉTICA<br>ACASO INÚTIL
      </h1>
      <p class="font-body hero-desc">Artículos para recuperar la esencia humana.</p>
    </div>
  </section>

  <section class="articles" id="articulos">
    <div class="articles-inner">
      <div class="section-marker"><span>Lectura / Videos</span></div>

      <TagFilter tags={tags} />

      {page.data.length === 0 && (
        <p class="font-body empty">Todavía no hay artículos publicados.</p>
      )}

      <div class="blog-layout">
        
        <!-- Columna principal: Artículos -->
        <main class="main-content">
          <div class="grid">
            {page.data.map((post, i) => (
              <PostCard 
                post={post} 
                index={(page.currentPage - 1) * POSTS_PER_PAGE + i} 
                featured={isFeaturedPage && i === 0} 
              />
            ))}
          </div>
          <Pagination currentPage={page.currentPage} lastPage={page.lastPage} urlFor={urlFor} />
        </main>

        <!-- Columna lateral: Sidebar -->
        <aside class="sidebar font-mono">
          
                    <!-- Caja de Donación -->
          <div class="sidebar-box donate-box">
            <h3 class="sidebar-title">APOYAR EL BLOG</h3>
            <p class="sidebar-text">Si te gusta este contenido, podés colaborar con el blog.</p>
            
            <a href='https://cafecito.app/elojoinusual' rel='noopener' target='_blank' class="cafecito-btn">
              <img 
                srcset='https://cdn.cafecito.app/imgs/buttons/button_6.png 1x, https://cdn.cafecito.app/imgs/buttons/button_6_2x.png 2x, https://cdn.cafecito.app/imgs/buttons/button_6_3.75x.png 3.75x' 
                src='https://cdn.cafecito.app/imgs/buttons/button_6.png' 
                alt='Invitame un café en cafecito.app' 
                class="cafecito-img"
              />
            </a>
          </div>

          <!-- Caja de Archivo por Fecha -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">ARCHIVO</h3>
            <ul class="archive-list">
              {sortedYears.map(year => (
                <li class="archive-year">
                  <span class="year-title">{year}</span>
                  <ul class="archive-months">
                    {Object.keys(archiveData[year]).sort((a, b) => Number(b) - Number(a)).map(monthIdx => {
                      const monthNum = Number(monthIdx);
                      return (
                        <li>
                          <a href={`/archivo/${year}/${monthNum + 1}/`}>
                            {monthsNames[monthNum]} ({archiveData[year][monthNum]})
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
          
        </aside>

      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* Estilos del Hero (Tus originales de GitHub) */
  .hero-strip { position: relative; padding: 7rem 1.5rem 5rem; border-bottom: 1px solid var(--border); overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: 0; background: var(--bg); }
  .hero-bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: grayscale(0%) contrast(1) brightness(1.5);
    opacity: 0; animation: heroCrossfade 15s infinite;
    will-change: opacity, transform;
  }
  .hero-bg-img-1 { background-image: url('/images/hero-articulos-1.jpg'); animation-delay: 0s; }
  .hero-bg-img-2 { background-image: url('/images/hero-articulos-2.jpg'); animation-delay: 5s; }
  .hero-bg-img-3 { background-image: url('/images/hero-articulos-3.jpg'); animation-delay: 10s; }
  @keyframes heroCrossfade {
    0%   { opacity: 0; transform: scale(1); }
    13%  { opacity: 0.6; }
    26%  { opacity: 0.6; transform: scale(1.04); }
    46%  { opacity: 0; transform: scale(1.08); }
    100% { opacity: 0; transform: scale(1.08); }
  }
  .hero-bg-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(177, 177, 177, 0.75) 0%, rgba(247,245,240,0.35) 45%, var(--bg) 100%),
      radial-gradient(ellipse at 20% 30%, rgba(10, 124, 143, 0.10) 0%, transparent 55%);
  }
  .hero-inner { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }
  .eyebrow { color: #000000; letter-spacing: 0.25em; font-size: 12px; margin-bottom: 1rem; }
  .hero-title { font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; margin: 0 0 0.8rem; color: var(--fg); }
  .hero-desc { color: var(--fg-dim); font-size: 1.1rem; line-height: 1.7; max-width: 720px; }

  /* Estilos de los Artículos */
  .articles { padding: 5rem 1.5rem 7rem; }
  .articles-inner { max-width: 1200px; margin: 0 auto; }
  .empty { color: var(--muted); }

  /* Layout de dos columnas */
  .blog-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .blog-layout {
      flex-direction: row;
      align-items: flex-start;
    }
    .main-content {
      flex: 1;
      min-width: 0;
    }
    .sidebar {
      flex: 0 0 280px;
      position: sticky;
      top: 2rem;
    }
  }

  /* Grilla adaptable */
  .grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); 
    gap: 2rem; 
  }

  /* Estilos para el Sidebar (Sin recuadros) */
  .sidebar-box {
    padding: 0 0 2rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-light);
  }
  .sidebar-box:last-child {
    border-bottom: none;
  }
  .sidebar-title {
    font-size: 13px;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    color: var(--accent);
  }
  .sidebar-text {
    font-size: 13px;
    color: var(--fg-dim);
    margin-bottom: 1.2rem;
    line-height: 1.5;
  }
    .cafecito-btn {
    display: block;
    text-align: left;
  }
  .cafecito-img {
    max-width: 100%;
    height: auto;
    display: inline-block;
    transition: transform 0.2s;
  }
  .cafecito-img:hover { 
    transform: translateY(-2px); 
  }

  /* Botón secundario - Solo borde (Por si lo vuelves a usar) */
  .donate-btn.secondary {
    background: transparent;
    color: var(--accent);
  }
  .donate-btn.secondary:hover {
    transform: translateY(-2px); 
    background: var(--accent);
    color: #000;
  }
  
  .archive-list { list-style: none; padding: 0; margin: 0; }
  .archive-year { margin-bottom: 1.2rem; }
  .year-title { 
    display: block; 
    font-size: 13px; 
    font-weight: 700; 
    color: var(--fg); 
    margin-bottom: 0.5rem; 
  }
  .archive-months { list-style: none; padding-left: 0.8rem; margin: 0; }
  .archive-months li { margin-bottom: 0.3rem; }
  .archive-months a { 
    color: var(--fg-dim); 
    font-size: 13px; 
    text-decoration: none; 
    transition: color 0.3s;
  }
  .archive-months a:hover { color: var(--accent); }
</style>