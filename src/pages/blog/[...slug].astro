---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PrevNextNav from '../../components/PrevNextNav.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: i < posts.length - 1 ? posts[i + 1] : null, // más viejo
      next: i > 0 ? posts[i - 1] : null, // más nuevo
      related: posts
        .filter((p) => p.id !== post.id && p.data.tag === post.data.tag)
        .slice(0, 3),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
    related: CollectionEntry<'blog'>[];
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' }).replace('.', '').toUpperCase();
---
<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.cover} type="article" pubDate={post.data.pubDate} author={post.data.author}>
  <article class="post-wrapper" data-pagefind-body>
    <header class="post-hero">
      <div class="post-hero-bg">
        {post.data.cover && <img src={post.data.cover} alt="" data-pagefind-meta="image" />}
        <div class="post-hero-overlay"></div>
      </div>
      <div class="post-hero-inner">
        
        <!-- Nueva fila: Volver a la izquierda, Categoría a la derecha -->
        <div class="post-hero-top">
          <a href="/#articulos" class="font-mono back-link">← Volver | </a>
          <p class="font-mono post-tag">{post.data.tag}</p>
        </div>

        <h1 class="post-title">{post.data.title}</h1>
          
        <p class="font-mono post-meta">
          {post.data.author} · {formatDate(post.data.pubDate)}
          {post.data.minutesRead && <span> · {post.data.minutesRead} MIN</span>}
        </p>
      </div>
    </header>

    <div class="post">
      <TableOfContents headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>


<!-- Comentarios de Cusdis -->
<!-- Comentarios de Cusdis -->
<div class="post-comments">
  <div id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id="73027611-5bed-46fd-b03d-68ca51d3e3b5"
    data-page-id={post.id}
    data-page-url={Astro.url.pathname}
    data-page-title={post.data.title}
    data-lang="es"
  ></div>
  <script async defer src="https://cusdis.com/js/cusdis.js"></script> <!-- ACÁ CAMBIA .es.js por .js -->
</div>
  </article>

  <PrevNextNav prev={prev} next={next} />
  <RelatedPosts posts={related} tag={post.data.tag} />
</BaseLayout>

<style>

  .post-comments {
  max-width: 900px;
  margin: 4 auto 5rem;
  padding: 0 1.5rem;
}
  .post { max-width: 900px; margin: 0 auto; padding: 0 1.5rem 5rem; }

  .post-hero {
    position: relative; overflow: hidden;
    width: 100%;
    padding: 7rem 1.5rem 4rem; margin-bottom: 3rem;
  }
  .post-hero-bg { position: absolute; inset: 0; z-index: 0; background: var(--bg); }
  .post-hero-bg img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(100%) contrast(1.05) brightness(1.35);
    opacity: 0.5;
  }
  .post-hero-overlay {
    position: absolute; inset: 0;
    /* Acá le ponemos el nuevo color crema (#FCFCF2) en formato RGB */
    background:
      linear-gradient(180deg, rgba(252,252,242,0.75) 0%, rgba(252,252,242,0.55) 45%, var(--bg) 100%),
      radial-gradient(ellipse at 20% 30%, rgba(10, 124, 143, 0.10) 0%, transparent 55%);
  }
  .post-hero-inner { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }

  /* Contenedor flexible para ponerlos juntos en la misma línea */
  .post-hero-top {
    display: flex;
    justify-content: flex-start; /* Que arranquen juntos desde la izquierda */
    align-items: center;
    gap: 0.8rem; /* Acá controlas el espacio exacto entre "Volver" y la categoría */
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .back-link { color: #333333; font-size: 14px; letter-spacing: 0.15em; text-transform: uppercase; transition: color 0.3s; margin: 0; }
  .back-link:hover { color: var(--accent); }
  
  .post-tag { color: var(--accent); font-size: 14px; letter-spacing: 0.2em; text-transform: uppercase; margin: 0; }
  
  .post-title { 
    font-family: 'Noto Serif Display', serif; 
    font-size: clamp(2.5rem, 6vw, 4rem); /* Un tamaño grande para que reine */
    line-height: 1.1; 
    margin: 0 0 1.5rem; 
    color: var(--fg); 
    font-weight: 300; 
    text-transform: none; /* Respetar mayúscula tipo oración */
    letter-spacing: -0.01em;
  }
  .post-meta { color: var(--muted); font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; }


</style>