---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PrevNextNav from '../../components/PrevNextNav.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { authors, defaultAuthor } from '../../data/authors';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: i < posts.length - 1 ? posts[i + 1] : null, // más viejo
      next: i > 0 ? posts[i - 1] : null, // más nuevo
      related: posts
        .filter((p) => p.id !== post.id && p.data.tag === post.data.tag)
        .slice(0, 3),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
  related: CollectionEntry<'blog'>[];
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' }).replace('.', '').toUpperCase();

const currentUrl = Astro.url.href;

// Buscamos la info del autor (si no está, usamos la default)
const authorInfo = (authors as Record<string, any>)[post.data.author] || defaultAuthor;
---
<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.cover} type="article" pubDate={post.data.pubDate} author={post.data.author}>
  <article class="post-wrapper" data-pagefind-body>
    <header class="post-hero">
      <div class="post-hero-bg">
        {post.data.cover && <img src={post.data.cover} alt="" data-pagefind-meta="image" />}
        <div class="post-hero-overlay"></div>
      </div>
      <div class="post-hero-inner">
        
        <!-- Nueva fila: Volver a la izquierda, Categoría a la derecha -->
        <div class="post-hero-top">
          <a href="/#articulos" class="font-mono back-link">← Volver | </a>
          <p class="font-mono post-tag">{post.data.tag}</p>
        </div>

        <h1 class="post-title">{post.data.title}</h1>
          
        <p class="font-mono post-meta">
          {post.data.author} · {formatDate(post.data.pubDate)}
          {post.data.minutesRead && <span> · {post.data.minutesRead} MIN</span>}
        </p>
      </div>
    </header>

    <!-- Layout de 2 columnas: Texto a la izquierda, Autor a la derecha -->
    <div class="post-layout">
      
      <div class="post">
        <TableOfContents headings={headings} />
        <div class="prose">
          <Content />
        </div>

        <!-- ICONOS PARA COMPARTIR -->
        <div class="post-share">
          <span class="share-label">Compartir:</span>
          
          <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title)}%20${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp" class="share-link">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>

          <a href={`https://t.me/share/url?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener" aria-label="Compartir en Telegram" class="share-link">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.01-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.324-.437.89-.663.553-.225 3.46-1.354 7.499-2.046 1.334-.227 2.485-.348 3.392-.342z"/></svg>
          </a>

          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook" class="share-link">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>

          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" aria-label="Compartir en X" class="share-link">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>

          <a href={`https://threads.net/intent/post?text=${encodeURIComponent(post.data.title)}%20${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" aria-label="Compartir en Threads" class="share-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="share-icon" viewBox="0 0 16 16">
              <path d="M6.321 6.016c-.27-.18-1.166-.802-1.166-.802.756-1.081 1.753-1.502 3.132-1.502.975 0 1.803.327 2.394.948s.928 1.509 1.005 2.644q.492.207.905.484c1.109.745 1.719 1.86 1.719 3.137 0 2.716-2.226 5.075-6.256 5.075C4.594 16 1 13.987 1 7.994 1 2.034 4.482 0 8.044 0 9.69 0 13.55.243 15 5.036l-1.36.353C12.516 1.974 10.163 1.43 8.006 1.43c-3.565 0-5.582 2.171-5.582 6.79 0 4.143 2.254 6.343 5.63 6.343 2.777 0 4.847-1.443 4.847-3.556 0-1.438-1.208-2.127-1.27-2.127-.236 1.234-.868 3.31-3.644 3.31-1.618 0-3.013-1.118-3.013-2.582 0-2.09 1.984-2.847 3.55-2.847.586 0 1.294.04 1.663.114 0-.637-.54-1.728-1.9-1.728-1.25 0-1.566.405-1.967.868ZM8.716 8.19c-2.04 0-2.304.87-2.304 1.416 0 .878 1.043 1.168 1.6 1.168 1.02 0 2.067-.282 2.232-2.423a6.2 6.2 0 0 0-1.528-.161"/>
            </svg>
          </a>
        </div>

        <!-- COMENTARIOS -->
        <Comments postId={post.id} />

        <!-- MOVER ACÁ: ARTÍCULOS ANTERIOR/SIGUIENTE -->
        <PrevNextNav prev={prev} next={next} />
      </div>

      <!-- Sidebar del Autor -->
      <aside class="author-sidebar">
        <p class="author-sidebar-label">Sobre el autor:</p>
        <h3 class="author-sidebar-title">{post.data.author}</h3>
        <p class="author-sidebar-bio">
          {authorInfo.bio}
        </p>
        <a href={authorInfo.link} target={authorInfo.link.startsWith('http') ? '_blank' : '_self'} rel="noopener noreferrer" class="author-sidebar-link">
          Contactar →
        </a>
      </aside>

    </div>
  </article>

  <RelatedPosts posts={related} tag={post.data.tag} />
</BaseLayout>

<style>
  /* Layout del artículo: Texto + Sidebar */
  .post-layout {
    max-width: 1200px; /* Más ancho para que entren las dos columnas */
    margin: 0 auto 3rem;
    padding: 0 1.5rem;
    display: flex;
    gap: 4rem;
  }
  
  /* El texto del artículo */
  .post {
    max-width: 720px; /* Mantiene la lectura cómoda */
    flex: 1;
    margin: 0;
    padding: 0;
  }

  /* La sidebar del autor */
  .author-sidebar {
    width: 280px;
    flex-shrink: 0;
    position: sticky;
    top: 2rem;
    align-self: flex-start;
    padding-left: 2rem;
    border-left: 1px solid var(--border-light);
  }
  .author-sidebar-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  .author-sidebar-title {
    font-family: 'Noto Serif Display', serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .author-sidebar-bio {
    font-family: 'Libertinus Serif', serif;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--fg-dim);
    margin-bottom: 1.5rem;
  }
  .author-sidebar-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--fg-dim);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.3s;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }
  .author-sidebar-link:hover {
    color: var(--accent);
  }

  /* En celulares, que todo se apile hacia abajo */
  @media (max-width: 900px) {
    .post-layout {
      flex-direction: column;
      gap: 3rem;
      max-width: 720px;
    }
    .author-sidebar {
      width: 100%;
      position: static;
      border-left: none;
      border-top: 1px solid var(--border-light);
      padding-left: 0;
      padding-top: 2rem;
    }
  }

  /* Estilos para los links de compartir (Alineados a la izquierda) */
  .post-share {
    margin: 4.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem; 
  }
  .share-label {
    font-family: 'Libertinus Serif', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--muted);
    margin-right: 0.5rem;
  }
  .share-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333333;
    transition: color 0.3s;
  }
  .share-link:hover {
    color: var(--accent); 
  }
  .share-icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }
  .share-link:hover .share-icon {
    transform: scale(1.1);
  }

  /* Ajuste para Anterior/Siguiente (Alineado a la izquierda) */
  :global(.prev-next) {
    margin: 4rem 0 0 !important; /* Le sacamos el auto para que se pegue a la izquierda */
    max-width: none !important; /* Que ocupe todo el ancho de la columna */
  }

  .post-hero {
    position: relative; overflow: hidden;
    width: 100%;
    padding: 7rem 1.5rem 4rem; margin-bottom: 3rem;
  }
  .post-hero-bg { position: absolute; inset: 0; z-index: 0; background: var(--bg); }
  .post-hero-bg img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(100%) contrast(1.05) brightness(1.35);
    opacity: 0.5;
  }
  .post-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(252,252,242,0.75) 0%, rgba(252,252,242,0.55) 45%, var(--bg) 100%),
      radial-gradient(ellipse at 20% 30%, rgba(10, 124, 143, 0.10) 0%, transparent 55%);
  }
  .post-hero-inner { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }

  .post-hero-top {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .back-link { color: #333333; font-size: 14px; letter-spacing: 0.15em; text-transform: uppercase; transition: color 0.3s; margin: 0; }
  .back-link:hover { color: var(--accent); }
  
  .post-tag { color: var(--accent); font-size: 14px; letter-spacing: 0.2em; text-transform: uppercase; margin: 0; }
  
  .post-title { 
    font-family: 'Noto Serif Display', serif; 
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.1; 
    margin: 0 0 1.5rem; 
    color: var(--fg); 
    font-weight: 300; 
    text-transform: none;
    letter-spacing: -0.01em;
  }
  .post-meta { color: var(--muted); font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; }
</style>