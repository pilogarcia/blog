---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentSection from '../../components/CommentSection.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' }).replace('.', '').toUpperCase();
---
<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.cover} type="article">
  <article class="post">
    <header class="post-header">
      <a href="/#articulos" class="font-mono back-link">← Artículos</a>
      <p class="font-mono post-tag">{post.data.tag}</p>
      <h1 class="font-display post-title">{post.data.title}</h1>
      <p class="font-mono post-meta">
        {post.data.author} · {formatDate(post.data.pubDate)}
        {post.data.minutesRead && <span> · {post.data.minutesRead} MIN</span>}
      </p>
    </header>

   <div class="prose">
      <Content />
    </div>
  </article>

  <CommentSection
    pageId={post.id}
    pageTitle={post.data.title}
    pageUrl={Astro.url.href}
  />
</BaseLayout>

<style>
  .post { max-width: 900px; margin: 0 auto; padding: 4rem 1.5rem 7rem; }
  .post-header { border-bottom: 1px solid var(--border); padding-bottom: 3rem; margin-bottom: 3rem; }
  .back-link { color: var(--muted); font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; transition: color 0.3s; }
  .back-link:hover { color: var(--accent); }
  .post-tag { color: var(--accent); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; margin: 2rem 0 1rem; }
  .post-title { font-size: clamp(2rem, 5vw, 3rem); line-height: 0.95; margin: 0 0 1.5rem; }
  .post-meta { color: var(--muted); font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; }
</style>
