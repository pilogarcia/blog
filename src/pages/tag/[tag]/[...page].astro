---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { POSTS_PER_PAGE } from '../../../consts';
import { slugifyTag } from '../../../lib/tags';
import type { GetStaticPathsOptions, Page } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(allPosts.map((p) => p.data.tag))];

  return tags.flatMap((tag) => {
    const filtered = allPosts
      .filter((p) => p.data.tag === tag)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(filtered, {
      pageSize: POSTS_PER_PAGE,
      params: { tag: slugifyTag(tag) },
      props: { tagName: tag },
    });
  });
}

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  tagName: string;
}

const { page, tagName } = Astro.props;
const { tag: tagSlug } = Astro.params;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const allTags = [...new Set(allPosts.map((p) => p.data.tag))];

const urlFor = (n: number) => (n === 1 ? `/tag/${tagSlug}/` : `/tag/${tagSlug}/${n}/`);
---
<BaseLayout title={`Artículos sobre ${tagName}`}>
  <section class="tag-header">
    <div class="tag-header-inner">
      <p class="font-mono eyebrow">Categoría</p>
      <h1 class="font-display tag-title">{tagName}</h1>
    </div>
  </section>

  <section class="articles">
    <div class="articles-inner">
      <TagFilter tags={allTags} activeTag={tagName} />

      {page.data.length === 0 && (
        <p class="font-body empty">Todavía no hay artículos en esta categoría.</p>
      )}

      <div class="grid">
        {page.data.map((post, i) => (
          <PostCard post={post} index={(page.currentPage - 1) * POSTS_PER_PAGE + i} />
        ))}
      </div>

      <Pagination currentPage={page.currentPage} lastPage={page.lastPage} urlFor={urlFor} />
    </div>
  </section>
</BaseLayout>

<style>
  .tag-header { padding: 6rem 1.5rem 3rem; border-bottom: 1px solid var(--border); }
  .tag-header-inner { max-width: 1200px; margin: 0 auto; }
  .eyebrow { color: var(--accent); letter-spacing: 0.25em; font-size: 11px; margin-bottom: 1rem; }
   .tag-title { 
    font-family: 'Noto Serif Display', serif; 
    font-size: clamp(2rem, 5vw, 3rem); 
    line-height: 1.1; 
    margin: 0 0 1.5rem; 
    color: var(--fg); 
    font-weight: 250; 
    text-transform: none; /* Respetar mayúscula tipo oración */
    letter-spacing: -0.01em;
  }

  .articles { padding: 4rem 1.5rem 7rem; }
  .articles-inner { max-width: 1200px; margin: 0 auto; }
  .empty { color: var(--muted); }

  .grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
